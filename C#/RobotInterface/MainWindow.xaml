<Window x:Name="Box" x:Class="RobotInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotInterface"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="47"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="128.04"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30" Focusable="False"/>
        </Grid.ColumnDefinitions>
        <GroupBox x:Name="emission" Header="Emission" Background="#FF9A9696" BorderBrush="{x:Null}" Grid.Column="1" Grid.Row="1">
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap" Background="{x:Null}" BorderBrush="{x:Null}" TextChanged="TextBox_TextChanged" AcceptsReturn="True" KeyUp="TextBoxEmission_KeyUp"/>
        </GroupBox>
        <GroupBox x:Name="Reception" Header="Réception" Background="#FFBDBDBD" Grid.Column="3" BorderBrush="Black" Grid.Row="1">
            <TextBox x:Name="TextBoxréception" TextWrapping="Wrap" Background="{x:Null}" BorderBrush="{x:Null}" IsReadOnly="True"/>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Margin="5">
            

           


        </StackPanel>
        <Button x:Name="buttonEnvoyer" Grid.Column="3" Content="Envoyer" HorizontalAlignment="Left" Grid.Row="3" Width="54" Click="buttonEnvoyer_Click" Margin="28,1,0,0"/>
        <Button x:Name="ButtonClear" Grid.Column="3" Content="Clear" Grid.Row="3" HorizontalAlignment="Left" Width="50" Click="ButtonClear_Click" Margin="209,0,0,3" />
        <Button x:Name="Test" Grid.Column="3" Content="Test" HorizontalAlignment="Left" Margin="111,0,0,0" Grid.Row="3" Click="Test_Click" Width="54"/>

        <GroupBox x:Name="Led" Header="Leds" Background="#FF9A9696" BorderBrush="{x:Null}" HorizontalAlignment="Left" Grid.Column="1" Grid.Row="3" Margin="0,0,0,1" Width="42"/>


    </Grid>

</Window>
